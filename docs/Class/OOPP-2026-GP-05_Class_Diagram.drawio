      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass User {\n  &lt;&lt;abstract&gt;&gt;\n  -userId: int\n  -username: String\n  -passwordHash: String\n  -role: String\n  -firstName: String\n  -lastName: String\n  -email: String\n  -nic: String\n  -dob: Date\n  -phone: String\n  +login()\n  +logout()\n  +viewDashboard()\n}\n\nclass Address {\n  -street: String\n  -city: String\n  -postalCode: String\n  -country: String\n}\n\nclass Admin {\n  -adminId: int\n  +viewDashboard()\n  +createUserProfile()\n  +updateUserProfile()\n  +deactivateUserProfile()\n  +createCourse()\n  +updateCourse()\n  +deactivateCourse()\n  +createNotice()\n  +updateNotice()\n  +deleteNotice()\n  +createTimetable()\n  +updateTimetable()\n  +deleteTimetable()\n}\n\nclass Staff {\n  &lt;&lt;abstract&gt;&gt;\n  +viewDashboard()\n  +updateProfile()\n}\n\nclass Lecturer {\n  -lectureId: int\n  -designation: String\n  +viewDashboard()\n  +uploadMaterial()\n  +enterMark()\n}\n\nclass TechnicalOfficer {\n  -toId: int\n  +viewDashboard()\n  +markAttendance()\n  +approveMedical()\n}\n\nclass Undergraduate {\n  -stuId: int\n  -intakeDate: Date\n  -status: String\n  -batch: String\n  +viewDashboard()\n  +updateContactDetails()\n  +submitMedical()\n  +checkEligibility()\n  +calculateGPA()\n}\n\nclass Department {\n  -depId: int\n  -departmentName: String\n  -faculty: String\n}\n\nclass Course {\n  -courseId: int\n  -courseCode: String\n  -courseName: String\n  -creditsTheory: int\n  -creditsPractical: int\n  -semester: String\n  -courseType: String\n  +addMaterial()\n}\n\nclass CourseMaterial {\n  -materialId: int\n  -title: String\n  -uploadDate: Date\n}\n\nclass Enrollment {\n  -enrollmentId: int\n  -academicYear: String\n}\n\nclass Attendance {\n  -attendanceId: int\n  -sessionId: int\n  -sessionType: String\n  -sessionDate: Date\n  -status: String\n  -sessionHours: int\n  +calculatePercentage()\n}\n\nclass MedicalRecord {\n  -medicalId: int\n  -documentPath: String\n  -sessionDate: Date\n  -reason: String\n  -approvalStatus: String\n}\n\nclass Marks {\n  -markId: int\n  -marksValue: float\n  -evaluationType: String\n  -maxMarks: float\n}\n\nclass Grade {\n  -gradeId: int\n  -finalMark: float\n  -grade: String\n  -gradePoint: float\n  -semester: String\n}\n\nclass Notice {\n  -noticeId: int\n  -title: String\n  -content: String\n  -postedDate: Date\n  -targetRole: String\n}\n\nclass Timetable {\n  -timetableId: int\n  -day: String\n  -startTime: String\n  -endTime: String\n  -sessionType: String\n  -venue: String\n}\n\nUser &lt;|-- Admin\nUser &lt;|-- Staff\nUser &lt;|-- Undergraduate\nStaff &lt;|-- Lecturer\nStaff &lt;|-- TechnicalOfficer\nUser *-- Address : has\nStaff --&gt; Department : works in\nUndergraduate --&gt; Department : belongs to\nLecturer --&gt; Course : teaches\nLecturer --&gt; CourseMaterial : uploads\nCourse --&gt; CourseMaterial : has\nUndergraduate --&gt; Enrollment : makes\nCourse --&gt; Enrollment : includes\nUndergraduate --&gt; Attendance : has\nCourse --&gt; Attendance : tracks\nTechnicalOfficer --&gt; Attendance : records\nUndergraduate --&gt; MedicalRecord : submits\nTechnicalOfficer --&gt; MedicalRecord : approves\nUndergraduate --&gt; Marks : receives\nCourse --&gt; Marks : has\nLecturer --&gt; Marks : enters\nUndergraduate --&gt; Grade : earns\nCourse --&gt; Grade : has\nAdmin --&gt; Notice : posts\nAdmin --&gt; Timetable : creates\nAdmin --&gt; Course : creates\nCourse --&gt; Timetable : scheduled\n\nstyle User fill:#e8f1ff,stroke:#1f4e79,stroke-width:2px\nstyle Staff fill:#e8f1ff,stroke:#1f4e79,stroke-width:2px\nstyle Course fill:#fff2cc,stroke:#7f6000,stroke-width:2px\nstyle Undergraduate fill:#fff2cc,stroke:#7f6000,stroke-width:2px\nstyle Address fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px\nstyle Department fill:#e2f0d9,stroke:#548235,stroke-width:2px\nstyle CourseMaterial fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle Enrollment fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle Attendance fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle MedicalRecord fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle Marks fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle Grade fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle Notice fill:#fce4d6,stroke:#c65911,stroke-width:2px\nstyle Timetable fill:#fce4d6,stroke:#c65911,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TyYPfA7AlQIrLVtUCI_j-1">
