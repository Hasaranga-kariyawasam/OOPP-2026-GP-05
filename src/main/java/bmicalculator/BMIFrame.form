<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="bmicalculator.BMIFrame">
  <grid id="b2d01" binding="rootPanel" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="16" left="16" bottom="16" right="16"/>
    <constraints>
      <xy x="20" y="20" width="420" height="380"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="b2d02" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Units"/>
        </properties>
      </component>
      <component id="b2d03" class="javax.swing.JComboBox" binding="unitBox">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="Metric (kg, m)"/>
            <item value="English (lb, in)"/>
          </model>
        </properties>
      </component>
      <component id="b2d04" class="javax.swing.JLabel" binding="heightLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Height (m)"/>
        </properties>
      </component>
      <component id="b2d05" class="javax.swing.JTextField" binding="heightField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="b2d06" class="javax.swing.JLabel" binding="weightLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Weight (kg)"/>
        </properties>
      </component>
      <component id="b2d07" class="javax.swing.JTextField" binding="weightField">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="b2d08" class="javax.swing.JButton" binding="submitButton">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Submit"/>
        </properties>
      </component>
      <component id="b2d09" class="javax.swing.JButton" binding="clearButton">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Clear"/>
        </properties>
      </component>
      <component id="b2d10" class="javax.swing.JLabel" binding="answerLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Enter your details and press Submit"/>
        </properties>
      </component>
      <component id="bb720" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="BMI Calculator"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
