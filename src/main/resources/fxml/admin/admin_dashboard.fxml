<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="adm-root" stylesheets="@../../css/admin.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.student.StudentDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="adm-topbar">
            <StackPane maxHeight="44.0" maxWidth="44.0" minHeight="44.0" minWidth="44.0" prefHeight="44.0" prefWidth="44.0" styleClass="adm-logo-circle">
                <ImageView fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../img/FOT.png" />
                    </image>
                </ImageView>
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="1">
                <Label styleClass="adm-top-title" text="Faculty Management System" />
                <Label styleClass="adm-top-sub" text="Faculty of Technology - University of Ruhuna" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" prefHeight="623.0" prefWidth="798.0" spacing="10" styleClass="adm-root">
            <Label fx:id="roleLabel" prefHeight="15.0" prefWidth="50.0" styleClass="subtitle" />
        </VBox>
    </center>
</BorderPane>