<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.admin.NoticesSectionController">
<VBox spacing="16" styleClass="adm-overview">
    <VBox spacing="12" styleClass="adm-card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="adm-card-title" text="Notice Management" />
            <Label fx:id="countLabel" styleClass="adm-muted" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
        <TableView fx:id="table" minHeight="200.0" prefHeight="240.0" styleClass="adm-table" />
    </VBox>
    <VBox spacing="14" styleClass="adm-card">
        <Label styleClass="adm-card-title" text="Notice Details" />
        <GridPane hgap="18" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
            </columnConstraints>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Title" />
                <TextField fx:id="titleField" promptText="Notice title" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Audience" />
                <ComboBox fx:id="audienceBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                <Label styleClass="adm-label" text="Message" />
                <TextArea fx:id="contentArea" promptText="Notice message..." styleClass="adm-field" prefRowCount="5" wrapText="true" />
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleClear" styleClass="adm-btn-light" text="Clear" />
            <Button onAction="#handleDelete" styleClass="adm-btn-danger" text="Delete" />
            <Button onAction="#handleUpdate" styleClass="adm-btn-light" text="Update" />
            <Button onAction="#handleAdd" styleClass="adm-btn" text="Add Notice" />
        </HBox>
    </VBox>
</VBox>
</ScrollPane>
