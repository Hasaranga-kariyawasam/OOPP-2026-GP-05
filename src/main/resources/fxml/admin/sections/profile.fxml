<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.admin.ProfileSectionController">
<VBox spacing="16" styleClass="adm-overview">
    <VBox spacing="14" styleClass="adm-card">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <StackPane>
                <Circle fx:id="avatar" radius="48.0" styleClass="adm-avatar-big" />
                <Label fx:id="initialsLabel" styleClass="adm-initials-big" />
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="4">
                <Label styleClass="adm-card-title" text="My Profile" />
                <Label fx:id="usernameLabel" styleClass="adm-muted" />
                <Label fx:id="roleLabel" styleClass="adm-banner-date" />
            </VBox>
        </HBox>
        <VBox spacing="5">
            <Label styleClass="adm-label" text="Profile Picture" />
            <HBox spacing="10">
                <TextField fx:id="pictureField" editable="false" promptText="No picture selected" styleClass="adm-field" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleChoosePicture" styleClass="adm-btn-light" text="Choose..." />
                <Button onAction="#handleRemovePicture" styleClass="adm-btn-light" text="Remove" />
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="14" styleClass="adm-card">
        <Label styleClass="adm-card-title" text="Personal Details" />
        <GridPane hgap="18" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
            </columnConstraints>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="First Name" />
                <TextField fx:id="firstField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Last Name" />
                <TextField fx:id="lastField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="adm-label" text="Email" />
                <TextField fx:id="emailField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="adm-label" text="Phone" />
                <TextField fx:id="phoneField" promptText="e.g. 0771234567" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label styleClass="adm-label" text="NIC" />
                <TextField fx:id="nicField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label styleClass="adm-label" text="Date of Birth" />
                <DatePicker fx:id="dobPicker" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label styleClass="adm-label" text="Street" />
                <TextField fx:id="streetField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label styleClass="adm-label" text="City" />
                <TextField fx:id="cityField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="4">
                <Label styleClass="adm-label" text="Postal Code" />
                <TextField fx:id="postalField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <Label styleClass="adm-label" text="Country" />
                <TextField fx:id="countryField" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleSave" styleClass="adm-btn" text="Save Changes" />
        </HBox>
    </VBox>
    <VBox spacing="14" styleClass="adm-card">
        <Label styleClass="adm-card-title" text="Change Password" />
        <GridPane hgap="18" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
            </columnConstraints>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Current Password" />
                <PasswordField fx:id="currentPw" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="New Password" />
                <PasswordField fx:id="newPw" promptText="Min 6 characters" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Confirm New Password" />
                <PasswordField fx:id="confirmPw" promptText="" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleChangePassword" styleClass="adm-btn" text="Change Password" />
        </HBox>
    </VBox>
</VBox>
</ScrollPane>
