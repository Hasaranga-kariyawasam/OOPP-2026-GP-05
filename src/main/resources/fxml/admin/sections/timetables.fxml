<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.admin.TimetablesSectionController">
<VBox spacing="16" styleClass="adm-overview">
    <VBox spacing="12" styleClass="adm-card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="adm-card-title" text="Timetable Management" />
            <Label fx:id="countLabel" styleClass="adm-muted" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
        <TableView fx:id="table" minHeight="200.0" prefHeight="260.0" styleClass="adm-table" />
    </VBox>
    <VBox spacing="14" styleClass="adm-card">
        <Label styleClass="adm-card-title" text="Session Details" />
        <GridPane hgap="18" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
            </columnConstraints>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Course" />
                <ComboBox fx:id="courseBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Department" />
                <ComboBox fx:id="deptBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="adm-label" text="Day" />
                <ComboBox fx:id="dayBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="adm-label" text="Session Type" />
                <ComboBox fx:id="typeBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label styleClass="adm-label" text="Start (HH:mm)" />
                <TextField fx:id="startField" promptText="e.g. 08:30" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label styleClass="adm-label" text="End (HH:mm)" />
                <TextField fx:id="endField" promptText="e.g. 10:30" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                <Label styleClass="adm-label" text="Venue" />
                <TextField fx:id="venueField" promptText="e.g. Lab 1" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleClear" styleClass="adm-btn-light" text="Clear" />
            <Button onAction="#handleDelete" styleClass="adm-btn-danger" text="Delete" />
            <Button onAction="#handleUpdate" styleClass="adm-btn-light" text="Update" />
            <Button onAction="#handleAdd" styleClass="adm-btn" text="Add Session" />
        </HBox>
    </VBox>
</VBox>
</ScrollPane>
