<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.admin.AttendanceSectionController">
<VBox spacing="16" styleClass="adm-overview">
    <VBox spacing="12" styleClass="adm-card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="adm-card-title" text="Attendance Records" />
            <Label fx:id="countLabel" styleClass="adm-muted" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" onAction="#handleSearch" prefWidth="260.0" promptText="Search reg. no or course code" styleClass="adm-field" />
            <Button onAction="#handleSearch" styleClass="adm-btn" text="Search" />
        </HBox>
        <TableView fx:id="table" minHeight="200.0" prefHeight="420.0" styleClass="adm-table" />
    </VBox>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleAbsent" styleClass="adm-btn-danger" text="Mark Absent" />
        <Button onAction="#handlePresent" styleClass="adm-btn" text="Mark Present" />
    </HBox>
</VBox>
</ScrollPane>
