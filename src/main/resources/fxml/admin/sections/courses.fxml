<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.admin.CoursesSectionController">
<VBox spacing="16" styleClass="adm-overview">
    <VBox spacing="12" styleClass="adm-card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="adm-card-title" text="Course Management" />
            <Label fx:id="countLabel" styleClass="adm-muted" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" onAction="#handleSearch" prefWidth="260.0" promptText="Search code or name" styleClass="adm-field" />
            <Button onAction="#handleSearch" styleClass="adm-btn" text="Search" />
        </HBox>
        <TableView fx:id="table" minHeight="200.0" prefHeight="280.0" styleClass="adm-table" />
    </VBox>
    <VBox spacing="14" styleClass="adm-card">
        <Label styleClass="adm-card-title" text="Course Details" />
        <GridPane hgap="18" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.00" />
            </columnConstraints>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Course Code" />
                <TextField fx:id="codeField" promptText="e.g. ICT2132" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="adm-label" text="Course Name" />
                <TextField fx:id="nameField" promptText="e.g. Database Systems" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="adm-label" text="Theory Credits" />
                <TextField fx:id="theoryField" promptText="e.g. 3" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="adm-label" text="Practical Credits" />
                <TextField fx:id="practicalField" promptText="e.g. 0" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label styleClass="adm-label" text="Semester" />
                <TextField fx:id="semesterField" promptText="e.g. L2S1" styleClass="adm-field" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label styleClass="adm-label" text="Course Type" />
                <ComboBox fx:id="typeBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" GridPane.hgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label styleClass="adm-label" text="Lecturer" />
                <ComboBox fx:id="lecturerBox" promptText="" styleClass="adm-combo" maxWidth="Infinity" />
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleClear" styleClass="adm-btn-light" text="Clear" />
            <Button onAction="#handleDelete" styleClass="adm-btn-danger" text="Delete" />
            <Button onAction="#handleUpdate" styleClass="adm-btn-light" text="Update" />
            <Button onAction="#handleAdd" styleClass="adm-btn" text="Save" />
        </HBox>
    </VBox>
</VBox>
</ScrollPane>
