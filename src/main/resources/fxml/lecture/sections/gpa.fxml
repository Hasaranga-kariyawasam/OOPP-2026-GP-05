<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "GPA" tab of the marks screen. -->
<VBox spacing="14" style="-fx-padding: 16 4 4 4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerGpaController">

    <Label styleClass="adm-muted" text="SGPA (latest semester) and CGPA from the grade points and credits of every subject. Click a student to see the subjects and grades." wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" prefWidth="300.0" promptText="Search by reg. number or name" styleClass="adm-field" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="summaryLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="adm-table" HBox.hgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colReg" minWidth="100.0" text="Reg. No" />
                <TableColumn fx:id="colName" minWidth="130.0" text="Name" />
                <TableColumn fx:id="colStatus" minWidth="90.0" text="Status" />
                <TableColumn fx:id="colCredits" minWidth="60.0" text="Credits" />
                <TableColumn fx:id="colSgpa" minWidth="60.0" text="SGPA" />
                <TableColumn fx:id="colCgpa" minWidth="60.0" text="CGPA" />
            </columns>
        </TableView>

        <VBox maxWidth="430.0" minWidth="430.0" prefWidth="430.0" spacing="10" styleClass="adm-card">
            <Label fx:id="detailTitle" styleClass="adm-card-title" wrapText="true" />
            <Label fx:id="detailGpa" styleClass="adm-muted" wrapText="true" />
            <TableView fx:id="detailTable" styleClass="adm-table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="dCode" minWidth="70.0" text="Code" />
                    <TableColumn fx:id="dName" minWidth="120.0" text="Subject" />
                    <TableColumn fx:id="dSemester" minWidth="50.0" text="Sem" />
                    <TableColumn fx:id="dCredits" minWidth="45.0" text="Cr." />
                    <TableColumn fx:id="dMark" minWidth="55.0" text="Mark" />
                    <TableColumn fx:id="dGrade" minWidth="45.0" text="Grade" />
                    <TableColumn fx:id="dPoint" minWidth="45.0" text="Pts" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
