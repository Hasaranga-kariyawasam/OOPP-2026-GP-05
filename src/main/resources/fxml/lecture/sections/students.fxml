<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard, so it gets the adm-* styles from the dashboard's scene. -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.StudentDetailsController">

    <Label styleClass="adm-page-title" text="Student Details" />
    <Label styleClass="adm-muted" text="View-only list of undergraduates stored in the system." />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" prefWidth="320.0" promptText="Search by reg. number, name or email" styleClass="adm-field" />
        <ComboBox fx:id="batchCombo" prefWidth="150.0" styleClass="adm-combo" />
        <ComboBox fx:id="statusCombo" prefWidth="170.0" styleClass="adm-combo" />
        <Button onAction="#handleReset" styleClass="adm-btn-light" text="Reset" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="countLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="adm-table" HBox.hgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colReg" text="Reg. No" />
                <TableColumn fx:id="colName" text="Name" />
                <TableColumn fx:id="colBatch" text="Batch" />
                <TableColumn fx:id="colStatus" text="Status" />
                <TableColumn fx:id="colDept" text="Department" />
            </columns>
        </TableView>

        <VBox maxWidth="320.0" minWidth="320.0" prefWidth="320.0" spacing="12" styleClass="adm-card">
            <Label styleClass="adm-card-title" text="Details" />
            <Label fx:id="dName" styleClass="adm-label" wrapText="true" />
            <GridPane hgap="12" vgap="9">
                <columnConstraints>
                    <ColumnConstraints minWidth="84.0" prefWidth="84.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label styleClass="adm-tile-label" text="Reg. No" GridPane.rowIndex="0" />
                <Label fx:id="dReg" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label styleClass="adm-tile-label" text="Email" GridPane.rowIndex="1" />
                <Label fx:id="dEmail" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label styleClass="adm-tile-label" text="Phone" GridPane.rowIndex="2" />
                <Label fx:id="dPhone" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label styleClass="adm-tile-label" text="NIC" GridPane.rowIndex="3" />
                <Label fx:id="dNic" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label styleClass="adm-tile-label" text="Date of birth" GridPane.rowIndex="4" />
                <Label fx:id="dDob" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label styleClass="adm-tile-label" text="Address" GridPane.rowIndex="5" />
                <Label fx:id="dAddress" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Label styleClass="adm-tile-label" text="Department" GridPane.rowIndex="6" />
                <Label fx:id="dDept" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                <Label styleClass="adm-tile-label" text="Batch" GridPane.rowIndex="7" />
                <Label fx:id="dBatch" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                <Label styleClass="adm-tile-label" text="Status" GridPane.rowIndex="8" />
                <Label fx:id="dStatus" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                <Label styleClass="adm-tile-label" text="Intake date" GridPane.rowIndex="9" />
                <Label fx:id="dIntake" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="9" />
                <Label styleClass="adm-tile-label" text="Account" GridPane.rowIndex="10" />
                <Label fx:id="dAccount" styleClass="adm-label" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="10" />
            </GridPane>
        </VBox>
    </HBox>
</VBox>
