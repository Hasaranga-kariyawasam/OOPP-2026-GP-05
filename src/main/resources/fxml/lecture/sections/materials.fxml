<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="materials"), so it uses the dashboard's adm-* styles. -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerMaterialsController">

    <Label styleClass="adm-page-title" text="Course Materials" />
    <Label styleClass="adm-muted" text="Add a link to your course material, or click a title in the table to edit it." />

    <!-- FORM -->
    <VBox spacing="10" styleClass="adm-card">
        <Label styleClass="adm-tile-label" text="Course" />
        <ComboBox fx:id="courseCombo" maxWidth="Infinity" promptText="Select a course" styleClass="adm-combo" />

        <Label styleClass="adm-tile-label" text="Title" />
        <TextField fx:id="title" promptText="e.g. Week 1 - Introduction slides" styleClass="adm-field" />

        <Label styleClass="adm-tile-label" text="File URL" />
        <TextField fx:id="file" promptText="https://..." styleClass="adm-field" />

        <HBox spacing="10">
            <Button fx:id="addButton" onAction="#handleAdd" styleClass="adm-btn" text="Add" />
            <Button fx:id="updateButton" onAction="#handleUpdate" styleClass="adm-btn-light" text="Update" />
        </HBox>
    </VBox>

    <Label fx:id="messageLabel" managed="false" visible="false" wrapText="true" />

    <!-- TABLE: exactly two columns -->
    <TableView fx:id="table" minHeight="180.0" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTitle" text="Title" />
            <TableColumn fx:id="colUrl" text="URL" />
        </columns>
    </TableView>
</VBox>
