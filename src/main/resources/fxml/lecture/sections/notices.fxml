<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="notices"). -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerNoticesController">

    <Label styleClass="adm-page-title" text="Notices" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-muted" text="Notices posted by the administration for lecturers. Click a notice to read it." />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="countLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="adm-table" HBox.hgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colDate" minWidth="140.0" text="Posted" />
                <TableColumn fx:id="colTitle" minWidth="200.0" text="Title" />
                <TableColumn fx:id="colBy" minWidth="120.0" text="Posted by" />
            </columns>
        </TableView>

        <VBox maxWidth="380.0" minWidth="380.0" prefWidth="380.0" spacing="10" styleClass="adm-card">
            <Label fx:id="dTitle" styleClass="adm-card-title" wrapText="true" />
            <Label fx:id="dMeta" styleClass="adm-muted" wrapText="true" />
            <TextArea fx:id="dContent" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>
</VBox>
