<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Grades" tab of the marks screen. -->
<VBox spacing="14" style="-fx-padding: 16 4 4 4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerGradesController">

    <Label styleClass="adm-muted" text="Final mark = 40% of the CA average + 60% of the final exam, graded with the UGC scale. A grade appears once a student has CA marks and a final exam mark." wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-label" text="Course" />
        <ComboBox fx:id="courseCombo" prefWidth="340.0" styleClass="adm-combo" />
        <TextField fx:id="searchField" prefWidth="260.0" promptText="Search by reg. number or name" styleClass="adm-field" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="summaryLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <TableView fx:id="table" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colReg" minWidth="100.0" text="Reg. No" />
            <TableColumn fx:id="colName" minWidth="150.0" text="Name" />
            <TableColumn fx:id="colCa" minWidth="90.0" text="CA average" />
            <TableColumn fx:id="colFinalExam" minWidth="90.0" text="Final exam" />
            <TableColumn fx:id="colFinalMark" minWidth="90.0" text="Final mark" />
            <TableColumn fx:id="colGrade" minWidth="60.0" text="Grade" />
            <TableColumn fx:id="colPoint" minWidth="60.0" text="Points" />
        </columns>
    </TableView>
</VBox>
