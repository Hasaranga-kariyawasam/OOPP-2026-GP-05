<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="medical"), so it uses the dashboard's adm-* styles. -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerMedicalController">

    <Label styleClass="adm-page-title" text="Medical Records" />
    <Label styleClass="adm-muted" text="View-only medical records of students enrolled in your courses. Technical officers approve or reject them." />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" prefWidth="320.0" promptText="Search by reg. number or name" styleClass="adm-field" />
        <ComboBox fx:id="statusCombo" prefWidth="170.0" styleClass="adm-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="countLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <TableView fx:id="table" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colReg" minWidth="100.0" text="Reg. No" />
            <TableColumn fx:id="colName" minWidth="150.0" text="Name" />
            <TableColumn fx:id="colDate" minWidth="100.0" text="Medical date" />
            <TableColumn fx:id="colReason" minWidth="150.0" text="Reason" />
            <TableColumn fx:id="colStatus" minWidth="90.0" text="Status" />
            <TableColumn fx:id="colDecidedBy" minWidth="130.0" text="Decided by" />
        </columns>
    </TableView>
</VBox>
