<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="timetable"). -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerTimetableController">

    <Label styleClass="adm-page-title" text="Timetable" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-muted" text="Weekly sessions of the courses you teach." />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="summaryLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <TableView fx:id="table" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colDay" minWidth="90.0" text="Day" />
            <TableColumn fx:id="colTime" minWidth="110.0" text="Time" />
            <TableColumn fx:id="colCode" minWidth="80.0" text="Code" />
            <TableColumn fx:id="colName" minWidth="200.0" text="Course" />
            <TableColumn fx:id="colType" minWidth="80.0" text="Type" />
            <TableColumn fx:id="colVenue" minWidth="100.0" text="Venue" />
        </columns>
    </TableView>
</VBox>
