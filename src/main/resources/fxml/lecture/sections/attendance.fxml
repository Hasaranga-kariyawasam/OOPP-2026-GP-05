<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="attendance"), so it uses the dashboard's adm-* styles. -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerAttendanceController">

    <Label styleClass="adm-page-title" text="Attendance" />
    <Label styleClass="adm-muted" text="View-only attendance of your students. 80% is required; approved medical absences are counted in the 'With medical' column." wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-label" text="Course" />
        <ComboBox fx:id="courseCombo" prefWidth="340.0" styleClass="adm-combo" />
        <TextField fx:id="searchField" prefWidth="260.0" promptText="Search by reg. number or name" styleClass="adm-field" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="countLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <TableView fx:id="table" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colReg" minWidth="100.0" text="Reg. No" />
            <TableColumn fx:id="colName" minWidth="150.0" text="Name" />
            <TableColumn fx:id="colTheory" minWidth="70.0" text="Theory" />
            <TableColumn fx:id="colPractical" minWidth="70.0" text="Practical" />
            <TableColumn fx:id="colOverall" minWidth="70.0" text="Overall" />
            <TableColumn fx:id="colWithMedical" minWidth="90.0" text="With medical" />
            <TableColumn fx:id="colScenario" minWidth="170.0" text="Status" />
            <TableColumn fx:id="colEligible" minWidth="70.0" text="Eligible" />
        </columns>
    </TableView>
</VBox>
