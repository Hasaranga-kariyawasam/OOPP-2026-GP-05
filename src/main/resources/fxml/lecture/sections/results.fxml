<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="results"). -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerEligibilityController">

    <Label styleClass="adm-page-title" text="Eligibility" />
    <Label styleClass="adm-muted" text="A student is eligible for the exam when the CA average is at least 40% and attendance is at least 80% (approved medical absences count as attended)." wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-label" text="Course" />
        <ComboBox fx:id="courseCombo" prefWidth="340.0" styleClass="adm-combo" />
        <TextField fx:id="searchField" prefWidth="240.0" promptText="Search by reg. number or name" styleClass="adm-field" />
        <ComboBox fx:id="statusCombo" prefWidth="150.0" styleClass="adm-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="summaryLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <TableView fx:id="table" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colReg" minWidth="100.0" text="Reg. No" />
            <TableColumn fx:id="colName" minWidth="150.0" text="Name" />
            <TableColumn fx:id="colCa" minWidth="90.0" text="CA average" />
            <TableColumn fx:id="colAttendance" minWidth="90.0" text="Attendance" />
            <TableColumn fx:id="colEligible" minWidth="70.0" text="Eligible" />
            <TableColumn fx:id="colRemark" minWidth="220.0" text="Remark" />
        </columns>
    </TableView>
</VBox>
