<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Loaded inside the lecturer dashboard (menu button id="courses"), so it uses the dashboard's adm-* styles. -->
<VBox spacing="14" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerCoursesController">

    <Label styleClass="adm-page-title" text="My Courses" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-muted" text="Courses currently assigned to you." />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="summaryLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" style="-fx-text-fill: #b91c1c;" visible="false" />

    <TableView fx:id="table" styleClass="adm-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCode" minWidth="80.0" text="Code" />
            <TableColumn fx:id="colName" minWidth="200.0" text="Course Name" />
            <TableColumn fx:id="colSemester" minWidth="70.0" text="Semester" />
            <TableColumn fx:id="colType" minWidth="120.0" text="Type" />
            <TableColumn fx:id="colTheory" minWidth="70.0" text="Theory Cr." />
            <TableColumn fx:id="colPractical" minWidth="80.0" text="Practical Cr." />
            <TableColumn fx:id="colTotal" minWidth="70.0" text="Total Cr." />
            <TableColumn fx:id="colStudents" minWidth="70.0" text="Students" />
        </columns>
    </TableView>
</VBox>
