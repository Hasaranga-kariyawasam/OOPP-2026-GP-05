<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Marks" tab of the marks screen (marks.fxml): enter / update / view marks. -->
<VBox spacing="14" style="-fx-padding: 16 4 4 4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.faculty.controller.lecture.LecturerMarksController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="adm-label" text="Course" />
        <ComboBox fx:id="courseCombo" prefWidth="340.0" styleClass="adm-combo" />
        <TextField fx:id="searchField" prefWidth="260.0" promptText="Search by reg. number or name" styleClass="adm-field" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="countLabel" styleClass="adm-muted" />
    </HBox>

    <Label fx:id="messageLabel" managed="false" visible="false" />

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="adm-table" HBox.hgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colReg" text="Reg. No" />
                <TableColumn fx:id="colName" text="Name" />
                <TableColumn fx:id="colType" text="Evaluation" />
                <TableColumn fx:id="colCategory" text="Category" />
                <TableColumn fx:id="colMark" text="Mark (/100)" />
            </columns>
        </TableView>

        <VBox maxWidth="300.0" minWidth="300.0" prefWidth="300.0" spacing="10" styleClass="adm-card">
            <Label styleClass="adm-card-title" text="Enter / Update Mark" />
            <Label styleClass="adm-tile-label" text="Student" />
            <ComboBox fx:id="studentCombo" maxWidth="Infinity" promptText="Choose a student" styleClass="adm-combo" />
            <Label styleClass="adm-tile-label" text="Evaluation type" />
            <ComboBox fx:id="typeCombo" editable="true" maxWidth="Infinity" promptText="QUIZ1, MID, FINAL ..." styleClass="adm-combo" />
            <Label styleClass="adm-tile-label" text="Category" />
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="adm-combo" />
            <Label styleClass="adm-tile-label" text="Mark (0 - 100)" />
            <TextField fx:id="markField" promptText="e.g. 72.5" styleClass="adm-field" />
            <HBox spacing="8">
                <Button onAction="#handleSave" styleClass="adm-btn" text="Save" />
                <Button onAction="#handleClear" styleClass="adm-btn-light" text="Clear" />
                <Button fx:id="deleteButton" onAction="#handleDelete" styleClass="adm-btn-danger" text="Delete" />
            </HBox>
            <Label styleClass="adm-muted" text="Tip: click a row in the table to change its mark." wrapText="true" />
        </VBox>
    </HBox>
</VBox>
