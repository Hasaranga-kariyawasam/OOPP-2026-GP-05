<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="to-root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.faculty.controller.TODashboardController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="220" spacing="6" styleClass="to-sidebar">
            <padding>
                <Insets top="24" right="14" bottom="20" left="14"/>
            </padding>

            <VBox spacing="2">
                <Label text="Faculty of Technology" styleClass="to-brand-title"/>
                <Label text="Technical Officer" styleClass="to-brand-sub"/>
            </VBox>
            <Region prefHeight="18"/>

            <Button fx:id="btnDashboard" text="🏠  Dashboard" maxWidth="Infinity"
                    styleClass="to-nav-btn, to-nav-active" onAction="#handleNav"/>
            <Button fx:id="btnAttendance" text="📝  Mark Attendance" maxWidth="Infinity"
                    styleClass="to-nav-btn" onAction="#handleNav"/>
            <Button fx:id="btnMedical" text="🩺  Medical Approvals" maxWidth="Infinity"
                    styleClass="to-nav-btn" onAction="#handleNav"/>
            <Button fx:id="btnTimetable" text="📅  Timetable" maxWidth="Infinity"
                    styleClass="to-nav-btn" onAction="#handleNav"/>
            <Button fx:id="btnNotices" text="📢  Notices" maxWidth="Infinity"
                    styleClass="to-nav-btn" onAction="#handleNav"/>
            <Button fx:id="btnProfile" text="👤  My Profile" maxWidth="Infinity"
                    styleClass="to-nav-btn" onAction="#handleNav"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⏻  Logout" maxWidth="Infinity"
                    styleClass="to-logout-btn" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="pageTitle" text="Dashboard" styleClass="to-page-title"/>
                    <Label fx:id="dateLabel" text="Today" styleClass="to-date"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="userChipLabel" text="User" styleClass="to-user-chip"/>
            </HBox>

            <!-- Stat cards -->
            <HBox spacing="16">
                <VBox spacing="6" styleClass="to-card, to-card-orange" HBox.hgrow="ALWAYS">
                    <Label text="Pending Medicals" styleClass="to-card-label"/>
                    <Label fx:id="pendingMedicalsLabel" text="0" styleClass="to-card-value"/>
                    <Label text="Waiting for approval" styleClass="to-card-hint"/>
                </VBox>
                <VBox spacing="6" styleClass="to-card, to-card-blue" HBox.hgrow="ALWAYS">
                    <Label text="Today's Sessions" styleClass="to-card-label"/>
                    <Label fx:id="todaySessionsLabel" text="0" styleClass="to-card-value"/>
                    <Label text="Scheduled for today" styleClass="to-card-hint"/>
                </VBox>
                <VBox spacing="6" styleClass="to-card, to-card-green" HBox.hgrow="ALWAYS">
                    <Label text="Attendance Records" styleClass="to-card-label"/>
                    <Label fx:id="recordsLabel" text="0" styleClass="to-card-value"/>
                    <Label text="Recorded by you" styleClass="to-card-hint"/>
                </VBox>
            </HBox>

            <!-- Two panels -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="10" styleClass="to-panel" HBox.hgrow="ALWAYS">
                    <Label text="Recent Medical Requests" styleClass="to-panel-title"/>
                    <TableView fx:id="medicalTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colStudent" text="Student"/>
                            <TableColumn fx:id="colDate" text="Date"/>
                            <TableColumn fx:id="colStatus" text="Status"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No medical requests yet"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <VBox spacing="10" styleClass="to-panel" prefWidth="230" minWidth="200">
                    <Label text="Today's Schedule" styleClass="to-panel-title"/>
                    <ListView fx:id="scheduleList" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="No sessions today"/>
                        </placeholder>
                    </ListView>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>